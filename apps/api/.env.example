# Copy to .env for local development.
#
# IMPORTANT: this is NOT the same connection-string format as apps/web's
# DATABASE_URL. Both point at the same Postgres database, but SQLAlchemy's
# async engine needs the `+asyncpg` driver marker that Prisma doesn't use.
#   apps/web:  postgresql://user:pass@host:port/db
#   apps/api:  postgresql+asyncpg://user:pass@host:port/db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:55432/watchtower"

ENVIRONMENT="development"
CORS_ORIGINS="http://localhost:3000"
DEFAULT_RATE_LIMIT="120/minute"
SENTRY_DSN=""
