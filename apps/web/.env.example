# Copy this file to .env for local development: cp .env.example .env
# NEVER commit the real .env file — see repo .gitignore.

# --- Database (Postgres) ---
# Local dev: run `npm run db:test-up` (repo root) to start a real, embedded
# Postgres with no Docker required, or point this at your own Postgres
# instance. Production: use a free Supabase Postgres project's connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/watchtower?schema=public"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- OAuth providers ---
# GitHub: https://github.com/settings/developers -> New OAuth App
#   Homepage URL: http://localhost:3000
#   Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email ---
# Leave both blank in local dev: emails are sent to a free, auto-created
# Ethereal test inbox and the preview link is printed to the server console.
# In production, set ONE of these:
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Watchtower <onboarding@yourdomain.com>"

# --- GitHub App (Phase 2 — repo ingestion, separate from the OAuth App above) ---
# github.com/settings/apps -> New GitHub App
#   Webhook URL: https://yourdomain.com/api/webhooks/github
#   Setup URL (redirect after install): https://yourdomain.com/api/github/callback
#   Permissions: Repository contents (READ AND WRITE — Phase 3 commits an
#     incident report to a new branch), Issues (read), Pull requests (READ
#     AND WRITE — Phase 3 opens draft PRs), Checks (read)
#   Subscribe to events: Issues, Pull request, Check run
# After creating: also enable the "phase2.github_ingestion" feature flag in
# /admin — connections and webhooks are refused while it's off.
GITHUB_APP_SLUG=""
GITHUB_APP_ID=""
# Paste the downloaded .pem's contents with real newlines replaced by \n
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""

# --- LLM provider (Phase 3 — root-cause analysis) ---
# Leave LLM_PROVIDER unset (or "none") and every investigation honestly
# abstains instead of guessing. Also enable the "phase3.ai_rca" feature flag
# in /admin for CI-failure investigations to auto-trigger; manual
# "Investigate" clicks work regardless of that flag.
#
# Free, self-hosted option (recommended): install Ollama (ollama.com),
# run `ollama pull llama3.1`, then:
LLM_PROVIDER="" # "ollama" | "anthropic" | "" (abstain)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
# Optional paid alternative — the only component in Watchtower with a
# per-token cost, and only used if you set LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Monitoring ---
# Free Sentry project: https://sentry.io -> New Project -> Next.js
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
